<?xml version="1.0" encoding="UTF-8"?>
<!-- BPMN 2.0 sense atributs de Flowable: propietats d'execució amb helium:* i assignació estàndard -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:helium="http://www.caib.es/helium/bpmn"
                  id="definicions"
                  targetNamespace="http://www.caib.es/helium/test">

  <bpmn:process id="procesTasques" isExecutable="true" helium:candidateStarterUsers="joan" helium:candidateStarterGroups="tramitadors">
    <bpmn:startEvent id="inici" helium:initiator="iniciador" helium:formKey="formInici"/>
    <bpmn:sequenceFlow id="f1" sourceRef="inici" targetRef="tascaUsuari"/>
    <bpmn:userTask id="tascaUsuari" name="Tasca d'usuari"
                   helium:formKey="formTasca" helium:priority="70" helium:category="categoriaProva" helium:dueDate="${dataLimit}">
      <!-- Forma que escriu l'editor (bpmn-moddle); el potentialOwner fa servir l'altra forma estàndard -->
      <bpmn:humanPerformer>
        <bpmn:resourceAssignmentExpression>
          <bpmn:expression xsi:type="bpmn:tFormalExpression">${responsable}</bpmn:expression>
        </bpmn:resourceAssignmentExpression>
      </bpmn:humanPerformer>
      <bpmn:potentialOwner>
        <bpmn:resourceAssignmentExpression>
          <bpmn:formalExpression>user(anna), group(gestors)</bpmn:formalExpression>
        </bpmn:resourceAssignmentExpression>
      </bpmn:potentialOwner>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="f2" sourceRef="tascaUsuari" targetRef="tascaAsincrona"/>
    <bpmn:serviceTask id="tascaAsincrona" helium:async="true" helium:exclusive="false" implementation="http://www.caib.es/helium/bpmn/handler">
      <bpmn:extensionElements>
        <helium:handler classe="es.caib.helium.logic.flowable.HandlerProva">
          <helium:parametre nom="text" valor="asincron"/>
        </helium:handler>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f3" sourceRef="tascaAsincrona" targetRef="fi"/>
    <bpmn:endEvent id="fi"/>
  </bpmn:process>

  <bpmn:process id="procesMultiInstancia" isExecutable="true">
    <bpmn:startEvent id="iniciMi"/>
    <bpmn:sequenceFlow id="mi1" sourceRef="iniciMi" targetRef="tascaMultiple"/>
    <bpmn:userTask id="tascaMultiple" name="Revisar element">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" helium:collection="${llista}" helium:elementVariable="element"/>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="mi2" sourceRef="tascaMultiple" targetRef="fiMi"/>
    <bpmn:endEvent id="fiMi"/>
  </bpmn:process>

  <bpmn:process id="procesPare" isExecutable="true">
    <bpmn:startEvent id="iniciPare"/>
    <bpmn:sequenceFlow id="p1" sourceRef="iniciPare" targetRef="cridaFill"/>
    <bpmn:callActivity id="cridaFill" calledElement="procesFill" helium:inheritVariables="true"/>
    <bpmn:sequenceFlow id="p2" sourceRef="cridaFill" targetRef="subprocesAsincron"/>
    <bpmn:subProcess id="subprocesAsincron" helium:async="true">
      <bpmn:startEvent id="iniciSub"/>
      <bpmn:sequenceFlow id="s1" sourceRef="iniciSub" targetRef="tascaSub"/>
      <bpmn:userTask id="tascaSub"/>
      <bpmn:sequenceFlow id="s2" sourceRef="tascaSub" targetRef="fiSub"/>
      <bpmn:endEvent id="fiSub"/>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="p3" sourceRef="subprocesAsincron" targetRef="fiPare"/>
    <bpmn:endEvent id="fiPare"/>
  </bpmn:process>

  <bpmn:process id="procesFill" isExecutable="true">
    <bpmn:startEvent id="iniciFill"/>
    <bpmn:sequenceFlow id="c1" sourceRef="iniciFill" targetRef="tascaFill"/>
    <bpmn:userTask id="tascaFill"/>
    <bpmn:sequenceFlow id="c2" sourceRef="tascaFill" targetRef="fiFill"/>
    <bpmn:endEvent id="fiFill"/>
  </bpmn:process>
</bpmn:definitions>
