<?xml version="1.0" encoding="UTF-8"?>
<!-- Handler síncron just després de l'inici: s'executa abans que la instància de procés retorni -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:helium="http://www.caib.es/helium/bpmn"
                  id="definicions"
                  targetNamespace="http://www.caib.es/helium/test">
  <bpmn:process id="procesHandlerSincron" isExecutable="true">
    <bpmn:startEvent id="inici"/>
    <bpmn:sequenceFlow id="f1" sourceRef="inici" targetRef="tascaComentari"/>
    <bpmn:serviceTask id="tascaComentari" implementation="http://www.caib.es/helium/bpmn/handler">
      <bpmn:extensionElements>
        <helium:handler classe="es.caib.helium.flowable.ExpedientComentariModificarHandlerProva">
          <helium:parametre nom="comentari" valor="Comentari a l'inici"/>
          <helium:parametre nom="varComentari" valor=""/>
        </helium:handler>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f2" sourceRef="tascaComentari" targetRef="revisar"/>
    <bpmn:userTask id="revisar"/>
    <bpmn:sequenceFlow id="f3" sourceRef="revisar" targetRef="fi"/>
    <bpmn:endEvent id="fi"/>
  </bpmn:process>
</bpmn:definitions>
