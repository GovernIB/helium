<?xml version="1.0" encoding="UTF-8"?>
<!-- Definició ja desplegada amb el format antic: flowable:class apuntant a un handler predefinit -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:flowable="http://flowable.org/bpmn"
                  id="definicions"
                  targetNamespace="http://www.caib.es/helium/test">
  <bpmn:process id="procesFlowableClassPredefinit" isExecutable="true">
    <bpmn:startEvent id="inici"/>
    <bpmn:sequenceFlow id="f1" sourceRef="inici" targetRef="tascaComentari"/>
    <bpmn:serviceTask id="tascaComentari" flowable:class="es.caib.helium.flowable.ExpedientComentariModificarHandlerProva">
      <bpmn:extensionElements>
        <flowable:field name="comentari">
          <flowable:expression>${comentariNou}</flowable:expression>
        </flowable:field>
        <flowable:field name="varComentari">
          <flowable:string></flowable:string>
        </flowable:field>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f2" sourceRef="tascaComentari" targetRef="fi"/>
    <bpmn:endEvent id="fi"/>
  </bpmn:process>
</bpmn:definitions>
