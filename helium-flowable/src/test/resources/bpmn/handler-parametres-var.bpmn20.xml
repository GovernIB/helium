<?xml version="1.0" encoding="UTF-8"?>
<!-- Definicions ja desplegades amb els antics paràmetres varXXX (codi d'una dada de l'expedient) -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:helium="http://www.caib.es/helium/bpmn"
                  xmlns:flowable="http://flowable.org/bpmn"
                  id="definicions"
                  targetNamespace="http://www.caib.es/helium/test">
  <bpmn:process id="procesParametresVar" isExecutable="true">
    <bpmn:startEvent id="inici"/>
    <bpmn:sequenceFlow id="f1" sourceRef="inici" targetRef="tascaAturar"/>
    <bpmn:serviceTask id="tascaAturar" implementation="http://www.caib.es/helium/bpmn/handler">
      <bpmn:extensionElements>
        <helium:handler classe="es.caib.helium.disseny.handler.ExpedientAturarHandler">
          <helium:parametre nom="motiu" valor="Motiu fix"/>
          <helium:parametre nom="varMotiu" valor="motiuDada"/>
        </helium:handler>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f2" sourceRef="tascaAturar" targetRef="tascaComentari"/>
    <bpmn:serviceTask id="tascaComentari" flowable:class="es.caib.helium.flowable.ExpedientComentariModificarHandlerProva">
      <bpmn:extensionElements>
        <flowable:field name="varComentari">
          <flowable:string>comentariDada</flowable:string>
        </flowable:field>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f3" sourceRef="tascaComentari" targetRef="fi"/>
    <bpmn:endEvent id="fi"/>
  </bpmn:process>
</bpmn:definitions>
